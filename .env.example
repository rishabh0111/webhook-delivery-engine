# PostgreSQL connection string. Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webhooks

# Redis connection string (BullMQ queue). Required.
REDIS_URL=redis://localhost:6379

# HTTP port for the API server.
PORT=3000

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# development | production | test
NODE_ENV=development

# Demo aids (in-process receiver, seed/reset/reconcile controls, runtime timing
# toggle). On by default outside production; set true to enable on a live deploy.
# DEMO_MODE=true

# Base URL the seeded demo subscriptions deliver to (the in-process receiver).
# Defaults to http://127.0.0.1:$PORT — override only if loopback can't reach it.
# PUBLIC_BASE_URL=http://127.0.0.1:3000

# Production base delay (ms) for BullMQ exponential backoff. The demo "fast mode"
# overrides this at runtime; this default is untouched by the toggle.
# BACKOFF_DELAY_MS=60000
